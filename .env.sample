# Valeurs factices : copie ce fichier en .env et remplace chaque valeur avant de lancer quoi que ce soit

# Lancement avec ./mvnw spring-boot:run (docker compose remplace l'hôte et le port par ceux de ses services)
DB_HOST_DEV=localhost
DB_PORT_DEV=3306
DB_NAME_DEV=candle_shop
DB_USER_DEV=candle_app
DB_PASSWORD_DEV=change-me-app
MONGODB_URI_DEV=mongodb://candle_app:change-me-mongo@localhost:27017/candle_shop
CLIENT_URL_DEV=http://localhost:4200
# 32 octets encodés en Base64 : génère le tien avec `openssl rand -base64 32`
JWT_SECRET=ZmFjdGljZS1hLXJlbXBsYWNlci0zMi1vY3RldHMhISE=
JWT_EXPIRATION_MS=3600000

# Lus seulement par docker compose, pour créer les comptes au premier démarrage des bases
MYSQL_ROOT_PASSWORD=change-me-root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=candle_app
MONGO_APP_PASSWORD=change-me-mongo
