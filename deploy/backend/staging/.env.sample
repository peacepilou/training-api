# Modèle du .env de ~/backend/staging/ sur le VPS : copie-le en .env, puis remplace CHAQUE valeur.
# Ce fichier-ci est commité ; le .env, jamais.

# Le compte limité du back, créé au premier démarrage de MySQL
DB_USER=candle_app
DB_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root

# Les comptes de MongoDB, créés à son premier démarrage
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=candle_app
MONGO_APP_PASSWORD=change-me-mongo

# L'adresse du front de staging, seule autorisée par le CORS. DOMAINE FACTICE : mets le tien
CLIENT_URL=https://staging.example.com

# 32 octets encodés en Base64 : génère le tien avec `openssl rand -base64 32`, différent de celui de la production
JWT_SECRET=ZmFjdGljZS1hLXJlbXBsYWNlci0zMi1vY3RldHMhISE=
JWT_EXPIRATION_MS=3600000
